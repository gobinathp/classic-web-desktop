{
  "name": "@gobinathp/classic-web-desktop",
  "version": "0.4.1",
  "description": "Lightweight React desktop and component toolkit with classic styling, modern controls, TypeScript, and no extra runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gobinathp/classic-web-desktop.git"
  },
  "homepage": "https://gobinathp.github.io/classic-web-desktop/",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js",
      "require": "./dist/desktop.cjs"
    },
    "./desktop.css": "./dist/desktop.css",
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./components.css": "./dist/components.css",
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "import": "./dist/controls.js",
      "require": "./dist/controls.cjs"
    },
    "./controls.css": "./dist/controls.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/model.test.ts",
    "test:browser": "playwright test",
    "check:size": "node scripts/size.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package && npm run check:size",
    "preview": "node scripts/serve.mjs",
    "prepack": "npm run build",
    "test:package": "node --test tests/package.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "keywords": [
    "react",
    "typescript",
    "component-library",
    "desktop-ui",
    "web-desktop",
    "lightweight",
    "classic-ui",
    "accessible-components",
    "window-manager"
  ],
  "author": "Gobinath Palanisamy",
  "bugs": {
    "url": "https://github.com/gobinathp/classic-web-desktop/issues"
  }
}
